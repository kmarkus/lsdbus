#!/usr/bin/lua

local u = require("utils")
local ac = require("ansicolors")
local lsdb = require("lsdbus")
local common = require("lsdbus.common")

local b, bus, verbose, color, show_stdif
color = true
local dbus_proxy

local function make_colorize(colorize)
   return function(s) if color then return colorize(s) else return s end end
end

local blue = make_colorize(ac.blue)
local bblue = make_colorize(function(s) return ac.bright(ac.blue(s or "")) end)
local red = make_colorize(ac.red)
local green = make_colorize(ac.green)
local cyan = make_colorize(ac.cyan)
local magenta = make_colorize(ac.magenta)
local bmagenta = make_colorize(function(s) return ac.bright(ac.magenta(s or "")) end)

local fmt = string.format

local function log(format, ...) if verbose then print(fmt(format, ...)) end end

local function help()
   print([=[
usage: lsdb-info COMMAND [ARGS] [FLAGS]

 list                             list all known services
 show SERVICE[,PATH[,INTERFACE]]  show a service, optionally filtered
                                  by path and interface
   -i                               include standard interfaces
                                    (Peer, Properties, Introspectable)
 help                             print this help

SERVICE, PATH and INTERFACE also match as plain substrings
if no exact match is found.

flags
 -r     raw output (dump internal introspection result)
 -s     system bus
 -u     session bus
 -C     disable colors
 -v     verbose
 -h     show this help
 -V     show version
]=])
end

local function get_services()
   local function cmd_from_pid(pid)
      local f = io.open(fmt("/proc/%i/comm", pid), 'r')
      if f then
         return string.gsub(f:read('*a'), '\n$', '')
      end
      return "unknown"
   end

   local res = {}
   local names = dbus_proxy('ListNames')

   for _,n in ipairs(names) do
      local creds = dbus_proxy('GetConnectionCredentials', n)
      local uid = dbus_proxy('GetNameOwner', n)
      local cmd = cmd_from_pid(creds.ProcessID)
      local wid_col = n:sub(1,1) == ':' and magenta(n) or cyan(n)
      res[#res+1] = {
         wid = wid_col,
         uid = magenta(uid),
         cmd = green(cmd),
         pid = blue(creds.ProcessID),
      }
   end

   table.sort(res, function(x, y) return x.wid<y.wid end)
   return res
end



local is_stdif = {
   ['org.freedesktop.DBus.Properties']=true,
   ['org.freedesktop.DBus.Introspectable']=true,
   ['org.freedesktop.DBus.Peer']=true
}

-- match x against target: exact match, or plain substring match
local function match(x, target)
   return x == target or x:find(target, 1, true) ~= nil
end

local function show(spec, raw)
   if not spec then
      print("missing service argument")
      os.exit(1)
   end

   local fields = {}
   for f in (spec .. ","):gmatch("([^,]*),") do
      fields[#fields + 1] = f
   end
   local s = fields[1] or ""
   local p = fields[2] or ""
   local i = fields[3] or ""

   if s == "" then
      print("missing service name")
      os.exit(1)
   end

   -- resolve service: exact name, then unique substring match
   local names = dbus_proxy('ListNames')
   local srv
   for _, n in ipairs(names) do
      if n == s then srv = s; break end
   end
   if not srv then
      local matches = {}
      for _, n in ipairs(names) do
         if n:sub(1,1) ~= ':' and n:find(s, 1, true) then
            matches[#matches+1] = n
         end
      end
      if #matches == 1 then
         srv = matches[1]
      elseif #matches == 0 then
         print(fmt("service '%s' not found", s))
         os.exit(1)
      else
         print(fmt("'%s' is ambiguous, matches %d services:", s, #matches))
         for _, m in ipairs(matches) do print("  " .. m) end
         os.exit(1)
      end
   end

   local objects = common.introspect(b, srv)

   if raw then
      u.pp(objects)
      return
   end

   print(bblue(srv))
   for _, o in ipairs(objects) do
      local pmatch = (p == "") or match(o.path, p)
      if pmatch then
         local path_shown = false
         for _, intf in ipairs(o.node.interfaces) do
            local imatch
            if i == "" then
               imatch = show_stdif or not is_stdif[intf.name]
            else
               imatch = match(intf.name, i)
            end
            if imatch then
               if not path_shown then
                  print(fmt("  %s", green(o.path)))
                  path_shown = true
               end
               print(fmt("    %s", cyan(intf.name)))

               print(fmt("      %s", bmagenta("Methods")))
               for mname, mtab in pairs(intf.methods) do
                  print(blue(fmt("        %s", common.met_tostr(mname, mtab))))
               end

               print(fmt("      %s", bmagenta("Properties")))
               for pname, ptab in pairs(intf.properties) do
                  print(blue(fmt("        %s", common.prop_tostr(pname, ptab))))
               end

               print(fmt("      %s", bmagenta("Signals")))
               for sname, stab in pairs(intf.signals) do
                  print(blue(fmt("        %s", common.sig_tostr(sname, stab))))
               end
            end
         end
      end
   end
end

local opttab = u.proc_args(arg)
local cmd = opttab[0][1] or 'list'

verbose = opttab['-v']
if opttab['-C'] then color = false end
if opttab['-i'] then show_stdif = true end
if opttab['-h'] then cmd = 'help' end
if opttab['-V'] then print(lsdb.version()); os.exit(0) end
if opttab['-s'] then bus='default_system'
elseif opttab['-u'] then bus='default_user' end

log("using %s bus", bus or 'default')
b = lsdb.open(bus)
dbus_proxy = lsdb.proxy.new(b, 'org.freedesktop.DBus', '/', 'org.freedesktop.DBus')

if cmd == 'list' then
   local services = get_services()
   local hdr = { 'wid', 'uid', 'cmd', 'pid' }
   local _, rows = u.tabulate(services, hdr)
   u.write_table(io.stdout, hdr, rows, {count=false})
elseif cmd == 'show' then
   show(opttab[0][2], opttab['-r'])
elseif cmd == 'help' then
   help()
   os.exit()
else
   print(fmt("unknown command %s", cmd))
   os.exit(1)
end
